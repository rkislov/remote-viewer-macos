+static gboolean quartz_request_guest_text(SpiceGtkSession *self, guint selection)
+{
+    SpiceGtkSessionPrivate *s = self->priv;
+    guint i;
+
+    if (!s->main || selection != VD_AGENT_CLIPBOARD_SELECTION_CLIPBOARD)
+        return FALSE;
+
+    for (i = 0; i < s->nclip_targets[selection]; i++) {
+        guint info = s->clip_targets[selection][i].info;
+        if (atom2agent[info].vdagent != VD_AGENT_CLIPBOARD_UTF8_TEXT)
+            continue;
+
+        /* NSPasteboard can ask for data from inside the native event loop.
+         * Fetch text before declaring ownership so the provider never needs
+         * to wait for the guest in a nested GLib main loop. */
+        s->quartz_text_requested = TRUE;
+        spice_main_channel_clipboard_selection_request(s->main, selection,
+                                                        VD_AGENT_CLIPBOARD_UTF8_TEXT);
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+static void quartz_clipboard_get_text(GtkClipboard *clipboard,
+                                     GtkSelectionData *selection_data,
+                                     guint info, gpointer user_data)
+{
+    const gchar *text = g_object_get_data(G_OBJECT(user_data), "spice-quartz-clipboard-text");
+    if (text)
+        gtk_selection_data_set_text(selection_data, text, -1);
+}
+
+static void quartz_guest_text_received(SpiceMainChannel *main, guint selection,
+                                       guint type, const guchar *data, guint size,
+                                       gpointer user_data)
+{
+    SpiceGtkSession *self = SPICE_GTK_SESSION(user_data);
+    SpiceGtkSessionPrivate *s = self->priv;
+    GtkTargetEntry target = { "UTF8_STRING", 0, 0 };
+    gchar *text;
+
+    if (main != s->main || selection != VD_AGENT_CLIPBOARD_SELECTION_CLIPBOARD ||
+        !s->quartz_text_requested || read_only(self) ||
+        type != VD_AGENT_CLIPBOARD_UTF8_TEXT || !data || size > G_MAXINT)
+        return;
+
+    if (size && data[size - 1] == '\0')
+        size--;
+    if (!g_utf8_validate((const gchar *)data, size, NULL))
+        return;
+
+    if (spice_main_channel_agent_test_capability(main, VD_AGENT_CAP_GUEST_LINEEND_CRLF))
+        text = spice_dos2unix((const gchar *)data, size);
+    else
+        text = g_strndup((const gchar *)data, size);
+
+    g_object_set_data_full(G_OBJECT(self), "spice-quartz-clipboard-text", text, g_free);
+    if (gtk_clipboard_set_with_owner(s->clipboard, &target, 1,
+                                     quartz_clipboard_get_text, clipboard_clear,
+                                     G_OBJECT(self))) {
+        s->clipboard_by_guest[selection] = TRUE;
+        s->clip_hasdata[selection] = FALSE;
+    }
+}
